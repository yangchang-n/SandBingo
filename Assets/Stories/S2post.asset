%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 24cee7e49fc532a45ab71bd5ace6cb7b, type: 3}
  m_Name: S2post
  m_EditorClassIdentifier: 
  lines:
  - hasDialogue: 1
    speakerNameEN: Piper
    dialogueTextEN: It's coming up, Tessa! We've got water!
    speakerNameKR: "\uD30C\uC774\uD37C"
    dialogueTextKR: "\uC62C\uB77C\uC640\uC694, \uD14C\uC0AC! \uBB3C\uC774\uC5D0\uC694!"
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Tessa
    dialogueTextEN: Whew... That one was a little rough, huh?
    speakerNameKR: "\uD14C\uC0AC"
    dialogueTextKR: "\uD734... \uC774\uBC88 \uAC74 \uADF8\uB798\uB3C4 \uC870\uAE08
      \uD798\uB4E4\uC5C8\uC5B4. \uADF8\uCE58?"
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Piper
    dialogueTextEN: Yeah. I was this close to giving up.
    speakerNameKR: "\uD30C\uC774\uD37C"
    dialogueTextKR: "\uADF8\uB7EC\uAC8C\uC694. \uD558\uB9C8\uD130\uBA74 \uAD00\uB458
      \uBED4\uD588\uC5B4\uC694."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Tessa
    dialogueTextEN: Thanks for sticking with it. Have some water and rest for a bit.
    speakerNameKR: "\uD14C\uC0AC"
    dialogueTextKR: "\uB05D\uAE4C\uC9C0 \uD574\uC918\uC11C \uACE0\uB9C8\uC6CC. \uBB3C\uBD80\uD130
      \uD55C \uBAA8\uAE08 \uB9C8\uC2DC\uACE0 \uC26C\uACE0 \uC788\uC5B4."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Piper
    dialogueTextEN: You too, Tessa. Nice work.
    speakerNameKR: "\uD30C\uC774\uD37C"
    dialogueTextKR: "\uD14C\uC0AC\uB3C4 \uC218\uACE0\uD588\uC5B4\uC694."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Piper
    dialogueTextEN: Hey, aren't you forgetting something?
    speakerNameKR: "\uD30C\uC774\uD37C"
    dialogueTextKR: "\uADFC\uB370 \uBB50 \uC78A\uC740 \uAC70 \uC5C6\uC5B4\uC694?"
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Tessa
    dialogueTextEN: Ah... right.
    speakerNameKR: "\uD14C\uC0AC"
    dialogueTextKR: "\uC544... \uADF8\uB798, \uB9DE\uC544."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Tessa
    dialogueTextEN: But it's not something I can exactly hand you.
    speakerNameKR: "\uD14C\uC0AC"
    dialogueTextKR: "\uADFC\uB370 \uADF8\uAC74 \uC904 \uC218 \uC788\uB294 \uBB34\uC5B8\uAC00\uB294
      \uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Tessa
    dialogueTextEN: It's not something you can carry around.
    speakerNameKR: "\uD14C\uC0AC"
    dialogueTextKR: "\uB4E4\uACE0 \uB2E4\uB2D0 \uC218 \uC788\uB294 \uAC8C \uC544\uB2C8\uB77C\uC11C."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Piper
    dialogueTextEN: This is sounding more suspicious by the second.
    speakerNameKR: "\uD30C\uC774\uD37C"
    dialogueTextKR: "\uC810\uC810 \uB354 \uC218\uC0C1\uD574\uC9C0\uB294\uB370\uC694."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Tessa
    dialogueTextEN: I know a place. It's a bit of a walk, though...
    speakerNameKR: "\uD14C\uC0AC"
    dialogueTextKR: "\uC544\uB294 \uACF3\uC774 \uC788\uC5B4. \uC880 \uAC78\uC5B4\uC57C
      \uB418\uAE34 \uD55C\uB370..."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
  - hasDialogue: 1
    speakerNameEN: Piper
    dialogueTextEN: Whew... Then let me rest a little longer before we head out.
    speakerNameKR: "\uD30C\uC774\uD37C"
    dialogueTextKR: "\uD734... \uADF8\uB7FC \uC870\uAE08\uB9CC \uB354 \uC26C\uC5C8\uB2E4
      \uCD9C\uBC1C\uD560\uB798\uC694."
    portrait: {fileID: 0}
    changeBackground: 0
    background: {fileID: 0}
    changePanel: 0
    characterPanel: {fileID: 0}
    changeBgm: 0
    bgm: {fileID: 0}
